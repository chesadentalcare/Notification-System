NODE_ENV=development
PORT=4600
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=3306
DB_USER=chesa
DB_PASSWORD=change-me
DB_NAME=notification_service

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notify@example.com
SMTP_PASS=change-me
SMTP_FROM="Chesa Dental Care <notify@example.com>"

FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# WhatsApp (Meta Graph API / WABA) — same account chesa_api_gateway uses.
WHATSAPP_API_BASE=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=500138309848954
WHATSAPP_WABA_ID=533013446553813
# Meta system-user access token (secret — leave blank locally / in dry-run).
WHATSAPP_ACCESS_TOKEN=
# Prepended to bare 10-digit numbers when normalizing recipients.
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Shared WhatsApp log written by chesa_api_gateway. This service READS it (so all
# conversations show here) and appends its own sends to <db>.whatsapp_outbound.
# The notify DB user needs SELECT on <db>.whatsapp_inbound and SELECT+INSERT on
# <db>.whatsapp_outbound. Set to the DB that holds those tables.
WHATSAPP_SOURCE_DB=production_dashboard

NOTIFY_DRY_RUN=0

# Admin API (consumed by notification-system-ui)
ADMIN_TOKEN=dev-admin-token
CORS_ORIGIN=http://localhost:5173
