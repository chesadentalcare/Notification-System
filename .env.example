NODE_ENV=development
PORT=4600
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=3306
DB_USER=chesa
DB_PASSWORD=change-me
DB_NAME=notification_service

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notify@example.com
SMTP_PASS=change-me
SMTP_FROM="Chesa Dental Care <notify@example.com>"

FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Multi-project push. JSON array; each item is one Firebase project (employees + dealers
# may live in different projects). Escape newlines in privateKey as \n. Leave blank to fall
# back to the single legacy FCM_PROJECT_ID/FCM_CLIENT_EMAIL/FCM_PRIVATE_KEY above.
# Example: FCM_PROJECTS=[{"projectId":"chesa-emp","clientEmail":"...@...","privateKey":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","label":"Employees"}]
FCM_PROJECTS=
# DBs holding the device-token tables + push logs.
# Employees: <FCM_EMPLOYEE_DB>.fcm_tokens + notification_logs
# Dealers:   <FCM_DEALER_DB>.dealer_fcm_tokens + dealer_notification_logs
FCM_EMPLOYEE_DB=production_dashboard
FCM_DEALER_DB=dealer_mobile_app

# WhatsApp (Meta Graph API / WABA) — same account chesa_api_gateway uses.
WHATSAPP_API_BASE=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=500138309848954
WHATSAPP_WABA_ID=533013446553813
# Meta system-user access token (secret — leave blank locally / in dry-run).
WHATSAPP_ACCESS_TOKEN=
# Prepended to bare 10-digit numbers when normalizing recipients.
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Shared WhatsApp log (read-only). Inbound messages live in the telecaller store,
# outbound in chesa's store. This service reads both to show all conversations and
# appends its own sends to <outbound_db>.whatsapp_outbound. The notify DB user needs
# SELECT on <inbound_db>.whatsapp_inbound and SELECT+INSERT on <outbound_db>.whatsapp_outbound.
WHATSAPP_INBOUND_DB=telecaller_crm_staging
WHATSAPP_OUTBOUND_DB=production_dashboard

NOTIFY_DRY_RUN=0

# Admin API (consumed by notification-system-ui)
ADMIN_TOKEN=dev-admin-token
CORS_ORIGIN=http://localhost:5173

# Care campaigns (chair-buyer base synced from SAP by chesa_api_gateway).
# care_customers lives in this DB and is read cross-DB on the same pool, so in
# production DB_HOST must point at the shared RDS (where notification_service +
# production_dashboard both live). The notify DB user needs SELECT on
# <CUSTOMERS_DB>.care_customers (and UPDATE for opt-outs).
CUSTOMERS_DB=production_dashboard
# Complaint/service-call site; care messages deep-link here, prefilled with ?phone=.
COMPLAINT_URL=https://servicecalls.ashvahealthtech.com/
# Client id recorded against care-campaign notifications, and the per-campaign cap.
CARE_CLIENT_ID=care
CARE_MAX_RECIPIENTS=5000
